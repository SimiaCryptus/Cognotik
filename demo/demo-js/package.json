{
  "scripts": {
    "backport-narrations": "node scripts/backport-narrations.js",
    "backport": "npm run backport-narrations narration-analysis-report.md cypress/fixtures/narrations.json"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:e2e:headless": "cypress run --headless --browser chrome",
    "test:e2e:record": "cypress run --headless --browser chrome --record",
    "test:e2e:chrome": "cypress run --browser chrome",
    "test:e2e:firefox": "cypress run --browser firefox",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate-audio": "node ./scripts/generate-narration-audio-groq.js",
    "generate-audio:groq": "node ./scripts/generate-narration-audio-groq.js",
    "generate-audio:chattts": "PYTHONPATH=../../../ChatTTS python3 ./scripts/generate-narration-audio.py"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "cypress": "^14.4.0",
    "eslint": "^9.27.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@cypress/webpack-preprocessor": "^6.0.4"
  }
}