#!/usr/bin/env bash
#
# Launcher for the Cognotik CLI file server.
#
# Resolves a release version, downloads `cli-<version>-all.jar` from GitHub
# releases into the directory next to this script (if not already present),
# verifies it, and execs it.
#
# See ./fileserver --help for usage.

set -Eeuo pipefail

# ------------------------------------------------------------------------------
# Constants
# ------------------------------------------------------------------------------
DEFAULT_REPO="SimiaCryptus/Cognotik"
FALLBACK_VERSION="2.1.19"
MAIN_CLASS="com.simiacryptus.cognotik.cli.FileServerCli"
MIN_JAVA_MAJOR=17
LOCK_TIMEOUT=300   # seconds to wait for a concurrent download
LOCK_STALE_MIN=30  # minutes after which a lock dir is considered stale

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
QUIET=0
log()  { (( QUIET )) || printf 'fileserver: %s\n' "$*" >&2; }
warn() { printf 'fileserver: warning: %s\n' "$*" >&2; }
die()  { printf 'fileserver: error: %s\n' "$*" >&2; exit 1; }

# ------------------------------------------------------------------------------
# Locate ourselves (resolving symlinks) so the script is CWD-independent
# ------------------------------------------------------------------------------
self="${BASH_SOURCE[0]}"
hops=0
while [[ -L "$self" ]]; do
  (( ++hops <= 40 )) || die "symlink loop while resolving ${BASH_SOURCE[0]}"
  target="$(readlink -- "$self")"
  if [[ "$target" == /* ]]; then
    self="$target"
  else
    self="$(dirname -- "$self")/$target"
  fi
done
SCRIPT_DIR="$(cd -- "$(dirname -- "$self")" && pwd -P)"
SCRIPT_NAME="$(basename -- "$self")"

REPO="${COGNOTIK_REPO:-$DEFAULT_REPO}"
CACHE_TTL="${COGNOTIK_CACHE_TTL:-86400}"
JAR_DIR="${COGNOTIK_JAR_DIR:-$SCRIPT_DIR}"
VERSION_CACHE="$JAR_DIR/.cognotik-latest-version"

# ------------------------------------------------------------------------------
# Cleanup / traps
# ------------------------------------------------------------------------------
TMP_FILE=""
LOCK_DIR=""
cleanup() {
  [[ -n "$TMP_FILE" && -e "$TMP_FILE" ]] && rm -f -- "$TMP_FILE"
  [[ -n "$LOCK_DIR"  && -d "$LOCK_DIR"  ]] && rmdir -- "$LOCK_DIR" 2>/dev/null
  return 0
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# ------------------------------------------------------------------------------
# Usage
# ------------------------------------------------------------------------------
usage() {
  cat <<EOF
Launcher for the Cognotik CLI file server.

Usage:
  $SCRIPT_NAME [launcher options] [--] [args passed to FileServerCli...]

Launcher options:
  --version <v>     Pin a release version (e.g. 2.1.19) instead of resolving
                    the latest release. Also accepts --version=<v> and a
                    leading "v" (v2.1.19).
  --update          Re-resolve the latest release and re-download the jar.
  --offline         Never touch the network; require a jar already on disk.
  --repo <o/r>      GitHub "owner/repo" to fetch releases from.
                    (default: $DEFAULT_REPO)
  --jar <path>      Use this jar verbatim; skips all resolution/downloading.
  --print-jar       Resolve (and fetch, unless --offline) then print the jar
                    path and exit without launching.
  --no-verify       Skip the published SHA-256 checksum verification.
  --quiet           Suppress informational messages.
  -h, --help        Show this help and exit.

Everything after the first non-option argument, or after "--", is forwarded
verbatim to $MAIN_CLASS.

Environment:
  COGNOTIK_VERSION    Same as --version.
  COGNOTIK_REPO       Same as --repo.
  COGNOTIK_JAR_DIR    Directory used to store/find jars (default: script dir).
  COGNOTIK_CACHE_TTL  Seconds to cache the "latest version" lookup (default 86400).
  GITHUB_TOKEN        Optional token used for the GitHub API lookup only
                      (avoids anonymous rate limiting).
  JAVA_HOME           If set and usable, \$JAVA_HOME/bin/java is used.
  JAVA_OPTS           Extra JVM options (word-split, e.g. "-Xmx2g -Dfoo=bar").

Examples:
  $SCRIPT_NAME --port 8080 /srv/files
  $SCRIPT_NAME --version 2.1.19 -- --help
  JAVA_OPTS=-Xmx2g $SCRIPT_NAME --update
EOF
}

# ------------------------------------------------------------------------------
# Option parsing (stops at the first unknown/positional arg or at "--")
# ------------------------------------------------------------------------------
VERSION="${COGNOTIK_VERSION:-}"
update=0
offline=0
verify=1
print_jar=0
JAR_OVERRIDE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --version)    [[ $# -ge 2 ]] || die "--version requires an argument"
                  VERSION="$2"; shift 2 ;;
    --version=*)  VERSION="${1#*=}"; shift ;;
    --repo)       [[ $# -ge 2 ]] || die "--repo requires an argument"
                  REPO="$2"; shift 2 ;;
    --repo=*)     REPO="${1#*=}"; shift ;;
    --jar)        [[ $# -ge 2 ]] || die "--jar requires an argument"
                  JAR_OVERRIDE="$2"; shift 2 ;;
    --jar=*)      JAR_OVERRIDE="${1#*=}"; shift ;;
    --update)     update=1; shift ;;
    --offline)    offline=1; shift ;;
    --no-verify)  verify=0; shift ;;
    --print-jar)  print_jar=1; shift ;;
    --quiet)      QUIET=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    --)           shift; break ;;
    *)            break ;;
  esac
done
VERSION="${VERSION#v}"

[[ "$REPO" == */* ]] || die "invalid --repo '$REPO' (expected owner/repo)"

# ------------------------------------------------------------------------------
# Java
# ------------------------------------------------------------------------------
have() { command -v "$1" >/dev/null 2>&1; }

if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
  JAVA_BIN="$JAVA_HOME/bin/java"
elif have java; then
  JAVA_BIN="$(command -v java)"
else
  die "no 'java' on PATH and JAVA_HOME is not usable"
fi

java_major_version() {
  local line ver major
  line="$("$JAVA_BIN" -version 2>&1 | head -n1)" || return 1
  ver="${line#*\"}"; ver="${ver%%\"*}"
  [[ "$ver" == 1.* ]] && ver="${ver#1.}"
  major="${ver%%[.\-_+]*}"
  case "$major" in (''|*[!0-9]*) return 1 ;; esac
  printf '%s\n' "$major"
}

if JAVA_MAJOR="$(java_major_version)"; then
  (( JAVA_MAJOR >= MIN_JAVA_MAJOR )) \
    || warn "Java $JAVA_MAJOR detected; Java $MIN_JAVA_MAJOR+ is recommended ($JAVA_BIN)"
fi

# ------------------------------------------------------------------------------
# HTTP helpers
# ------------------------------------------------------------------------------
tty_progress() { [[ -t 2 ]] && (( ! QUIET )); }

http_get() { # url -> stdout
  local url="$1"
  if have curl; then
    curl -fsSL --retry 2 --retry-delay 1 --connect-timeout 10 -- "$url"
  elif have wget; then
    wget -qO- --tries=2 --timeout=10 -- "$url"
  else
    return 127
  fi
}

gh_api_get() { # url -> stdout (adds auth header when GITHUB_TOKEN is set)
  local url="$1"
  if have curl; then
    if [[ -n "${GITHUB_TOKEN:-}" ]]; then
      curl -fsSL --retry 2 --connect-timeout 10 \
           -H "Authorization: Bearer $GITHUB_TOKEN" \
           -H "Accept: application/vnd.github+json" -- "$url"
    else
      curl -fsSL --retry 2 --connect-timeout 10 \
           -H "Accept: application/vnd.github+json" -- "$url"
    fi
  elif have wget; then
    if [[ -n "${GITHUB_TOKEN:-}" ]]; then
      wget -qO- --tries=2 --timeout=10 \
           --header="Authorization: Bearer $GITHUB_TOKEN" \
           --header="Accept: application/vnd.github+json" -- "$url"
    else
      wget -qO- --tries=2 --timeout=10 \
           --header="Accept: application/vnd.github+json" -- "$url"
    fi
  else
    return 127
  fi
}

http_effective_url() { # url -> final redirect target
  have curl || return 1
  curl -fsSLI -o /dev/null -w '%{url_effective}' --connect-timeout 10 -- "$1"
}

sha256_of() { # file -> hex digest (empty if no tool available)
  local f="$1"
  if have sha256sum; then
    sha256sum -- "$f" | awk '{print $1}'
  elif have shasum; then
    shasum -a 256 -- "$f" | awk '{print $1}'
  elif have openssl; then
    openssl dgst -sha256 -- "$f" | awk '{print $NF}'
  else
    printf ''
  fi
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

http_download() { # url dest
  local url="$1" dest="$2" expected actual

  TMP_FILE="$(mktemp -- "${dest}.part.XXXXXX")" \
    || die "cannot create temp file next to $dest"

  log "downloading $url"
  if have curl; then
    if tty_progress; then
      curl -fL --retry 2 --connect-timeout 10 --progress-bar -o "$TMP_FILE" -- "$url" \
        || die "download failed: $url"
    else
      curl -fsL --retry 2 --connect-timeout 10 -o "$TMP_FILE" -- "$url" \
        || die "download failed: $url"
    fi
  elif have wget; then
    wget -O "$TMP_FILE" --tries=2 --timeout=10 -- "$url" \
      || die "download failed: $url"
  else
    die "neither curl nor wget is available to download $url"
  fi

  # Sanity check: a jar is a zip archive ("PK").
  [[ -s "$TMP_FILE" && "$(head -c 2 -- "$TMP_FILE")" == "PK" ]] \
    || die "downloaded file is not a valid jar: $url"

  # Optional integrity check against a published <asset>.sha256 sidecar.
  if (( verify )); then
    expected="$(http_get "$url.sha256" 2>/dev/null | tr -d '\r' | awk 'NR==1{print $1}')" || expected=""
    if [[ -n "$expected" ]]; then
      actual="$(sha256_of "$TMP_FILE")"
      if [[ -z "$actual" ]]; then
        warn "no sha256 tool available; skipping checksum verification"
      elif [[ "$(lower "$actual")" != "$(lower "$expected")" ]]; then
        die "checksum mismatch for $url (expected $expected, got $actual)"
      else
        log "checksum verified"
      fi
    fi
  fi

  chmod 0644 -- "$TMP_FILE" 2>/dev/null || true
  mv -f -- "$TMP_FILE" "$dest" || die "cannot move jar into place: $dest"
  TMP_FILE=""
}

# ------------------------------------------------------------------------------
# Version resolution
# ------------------------------------------------------------------------------
cache_is_fresh() {
  [[ -s "$VERSION_CACHE" ]] || return 1
  local mins=$(( CACHE_TTL / 60 )); (( mins > 0 )) || mins=1
  [[ -n "$(find "$VERSION_CACHE" -maxdepth 0 -mmin "-$mins" 2>/dev/null)" ]]
}

newest_local_version() { # highest semver among cli-*-all.jar in JAR_DIR
  local -a jars=() versions=()
  local j v
  shopt -s nullglob
  jars=( "$JAR_DIR"/cli-*-all.jar )
  shopt -u nullglob
  (( ${#jars[@]} )) || return 1
  for j in "${jars[@]}"; do
    [[ -s "$j" ]] || continue
    v="${j##*/cli-}"; v="${v%-all.jar}"
    [[ -n "$v" ]] && versions+=( "$v" )
  done
  (( ${#versions[@]} )) || return 1
  printf '%s\n' "${versions[@]}" | { sort -V 2>/dev/null || sort; } | tail -n1
}

resolve_latest_version() {
  if (( ! update )) && cache_is_fresh; then
    tr -d '\r\n' <"$VERSION_CACHE"; printf '\n'; return 0
  fi
  local v="" json url
  if json="$(gh_api_get "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null)"; then
    v="$(printf '%s' "$json" \
         | grep -m1 '"tag_name"' \
         | sed -E 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v?([^"]+)".*/\1/')"
  fi
  if [[ -z "$v" ]] && url="$(http_effective_url "https://github.com/$REPO/releases/latest" 2>/dev/null)"; then
    v="${url##*/}"; v="${v#v}"
    [[ "$v" == "latest" || "$v" == *"/"* ]] && v=""
  fi
  [[ -n "$v" ]] || return 1
  printf '%s\n' "$v" >"$VERSION_CACHE" 2>/dev/null || true
  printf '%s\n' "$v"
}

# ------------------------------------------------------------------------------
# Locate / fetch the jar
# ------------------------------------------------------------------------------
if [[ -n "$JAR_OVERRIDE" ]]; then
  [[ -s "$JAR_OVERRIDE" ]] || die "jar not found or empty: $JAR_OVERRIDE"
  JAR="$JAR_OVERRIDE"
else
  if [[ -z "$VERSION" ]]; then
    if (( offline )); then
      VERSION="$(newest_local_version)" \
        || die "--offline given but no cli-*-all.jar found in $JAR_DIR"
    elif VERSION="$(resolve_latest_version)"; then
      :
    elif VERSION="$(newest_local_version)"; then
      warn "could not reach GitHub; using local version $VERSION"
    else
      warn "could not resolve latest release; falling back to $FALLBACK_VERSION"
      VERSION="$FALLBACK_VERSION"
    fi
  fi
  case "$VERSION" in
    ''|*[!A-Za-z0-9._+-]*) die "invalid version string: '$VERSION'" ;;
  esac

  JAR="$JAR_DIR/cli-$VERSION-all.jar"
  URL="https://github.com/$REPO/releases/download/v$VERSION/cli-$VERSION-all.jar"

  if (( update )) || [[ ! -s "$JAR" ]]; then
    (( offline )) && die "jar not present and --offline was given: $JAR"
    [[ -d "$JAR_DIR" ]] || die "jar directory does not exist: $JAR_DIR"
    [[ -w "$JAR_DIR" ]] || die "cannot write to $JAR_DIR (needed to store $(basename -- "$JAR"))"

    # Serialize concurrent launches so two processes don't fight over one jar.
    lock="$JAR.lock"
    if [[ -d "$lock" && -z "$(find "$lock" -maxdepth 0 -mmin "-$LOCK_STALE_MIN" 2>/dev/null)" ]]; then
      warn "removing stale lock $lock"
      rmdir -- "$lock" 2>/dev/null || rm -rf -- "$lock"
    fi
    waited=0
    until mkdir -- "$lock" 2>/dev/null; do
      (( waited < LOCK_TIMEOUT )) \
        || die "timed out waiting for another $SCRIPT_NAME to finish downloading $JAR"
      (( waited == 0 )) && log "waiting for another instance to finish downloading..."
      sleep 1; waited=$(( waited + 1 ))
    done
    LOCK_DIR="$lock"

    # Another process may have completed the download while we waited.
    if (( update )) || [[ ! -s "$JAR" ]]; then
      http_download "$URL" "$JAR"
    fi

    rmdir -- "$LOCK_DIR" 2>/dev/null || true
    LOCK_DIR=""
  fi
fi

[[ -s "$JAR" ]] || die "jar missing or empty: $JAR"

if (( print_jar )); then
  printf '%s\n' "$JAR"
  exit 0
fi

# ------------------------------------------------------------------------------
# Run
# ------------------------------------------------------------------------------
java_opts=()
if [[ -n "${JAVA_OPTS:-}" ]]; then
  # Deliberate word-splitting of JAVA_OPTS (no quote handling, by design).
  read -r -a java_opts <<<"$JAVA_OPTS"
fi

exec "$JAVA_BIN" ${java_opts[@]+"${java_opts[@]}"} -cp "$JAR" "$MAIN_CLASS" "$@"