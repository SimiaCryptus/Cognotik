/* =====================================================================
   main.mac — Rational Certificate Complexity (RCC) Companion Script

   An empirical verification / experimentation harness for the RCC essay.
   Every Theta(.) claim in the essay becomes a *measurable curve* that this
   script generates, fits, and reports against the predicted asymptotic.

   Backend: Maxima native exact rational (bignum) arithmetic. Floats are
   used ONLY for log-log curve fitting at the reporting stage (per G0.1).

   Run with:  maxima --batch=main.mac
   or load with:  load("main.mac")$  then  rcc_run_all()$
   ===================================================================== */

/* ---------------------------------------------------------------------
   0. INFRASTRUCTURE / HARNESS
   --------------------------------------------------------------------- */

/* High-precision reference constants (used only for error verification). */
rcc_fpprec : 200$
fpprec : rcc_fpprec$
rcc_pi_ref  : bfloat(%pi)$
rcc_e_ref   : bfloat(%e)$

/* G0.2 — Canonical bit-length metric.
   bits(p/q) = floor(log2|p|) + floor(log2|q|) + 2.
   Exposed as a single auditable function. Operates on an exact rational. */
rcc_bits(r) := block(
  [p, q],
  r : rat(r),
  p : num(r),
  q : denom(r),
  if p = 0 then 1
  else floor(log(abs(p))/log(2)) + floor(log(abs(q))/log(2)) + 2
)$

/* Helper: number of bits of a single positive integer (for lcm/product diagnostics). */
rcc_intbits(n) := if n <= 0 then 0 else floor(log(n)/log(2)) + 1$

/* Helper: exact rational -> bigfloat, for comparing against reference constant. */
rcc_bf(r) := bfloat(r)$

/* Helper: |approx - ref| as a bigfloat magnitude. */
rcc_abserr(approx, ref) := abs(bfloat(approx) - ref)$

/* G0.3 — Tolerance ladder: eps = 10^-1, ..., 10^-kmax (geometric). */
rcc_eps_ladder(kmax) := makelist(bfloat(10)^(-k), k, 1, kmax)$

/* ---------------------------------------------------------------------
   0.4 ASYMPTOTIC FITTER

   Given a table of (x, y) = (1/eps, metric) pairs, decide which growth
   model best matches via log-log / log-linear least squares slopes.

   Candidate models:
     LOG      : metric ~ a*log(1/eps) + b        (RC1)
     POLY     : metric ~ a*(1/eps)^c             (RC2, c>0)
     POLYLOG  : metric ~ (1/eps)*log(1/eps)      (RC2 high end, Wallis)
     EXP      : metric grows faster than any poly (RC3)

   The fitter returns [best_model_label, params, residual_summary].
   Floats permitted here (reporting stage only).
   --------------------------------------------------------------------- */

/* Simple least-squares slope/intercept for y = m*x + b over float lists. */
rcc_linfit(xs, ys) := block(
  [n, sx, sy, sxx, sxy, denom, m, b, i, xi, yi],
  n : length(xs),
  sx : 0.0, sy : 0.0, sxx : 0.0, sxy : 0.0,
  for i : 1 thru n do (
    xi : float(xs[i]),
    yi : float(ys[i]),
    sx : sx + xi,
    sy : sy + yi,
    sxx : sxx + xi*xi,
    sxy : sxy + xi*yi
  ),
  denom : n*sxx - sx*sx,
  if abs(denom) < 1e-300 then [0.0, sy/n]
  else (
    m : (n*sxy - sx*sy)/denom,
    b : (sy - m*sx)/n,
    [m, b]
  )
)$

/* Residual (sum of squared errors) of a linear fit to (xs, ys). */
rcc_linresidual(xs, ys, fit) := block(
  [m, b, s, i],
  m : fit[1], b : fit[2],
  s : 0.0,
  for i : 1 thru length(xs) do
    s : s + (float(ys[i]) - (m*float(xs[i]) + b))^2,
  s
)$

/* Coefficient of determination R^2 for a linear fit. */
rcc_r2(xs, ys, fit) := block(
  [m, b, ybar, sstot, ssres, i, n],
  m : fit[1], b : fit[2],
  n : length(ys),
  ybar : 0.0,
  for i : 1 thru n do ybar : ybar + float(ys[i]),
  ybar : ybar/n,
  sstot : 0.0, ssres : 0.0,
  for i : 1 thru n do (
    sstot : sstot + (float(ys[i]) - ybar)^2,
    ssres : ssres + (float(ys[i]) - (m*float(xs[i]) + b))^2
  ),
  if sstot < 1e-300 then 1.0 else 1.0 - ssres/sstot
)$

/* G0.4 — Asymptotic fitter.
   Input: list of [eps, metric] pairs (eps a bigfloat, metric a number).
   Strategy: build transformed coordinates and test each model's linearity.
     L = log(1/eps)   (natural log)
     M = metric
   LOG model     : M vs L          should be linear with positive slope, R^2 high.
   POLY model     : log(M) vs L     slope = exponent c (in nats of 1/eps).
   POLYLOG       : M vs (1/eps)*L   should be linear, R^2 high.
   We compare R^2 of the LOG fit, the POLYLOG fit, and the POLY (log-log) fit,
   plus inspect the POLY exponent to separate RC1 (~0), RC2 (finite c), RC3 (large/super).

   Returns a record list:
     [ class_label, detail ]
   where class_label in {"RC1","RC2","RC3","RC2-polylog"}.
   --------------------------------------------------------------------- */
rcc_fit_class(tbl) := block(
  [L, M, invE, polylogx, fit_log, fit_polylog, fit_loglog,
   r2_log, r2_polylog, r2_loglog, slope_loglog, i, n, logM,
   label, detail],
  n : length(tbl),
  L : makelist( float(log(1/bfloat(tbl[i][1]))), i, 1, n),
  M : makelist( float(tbl[i][2]), i, 1, n),
  invE : makelist( float(1/bfloat(tbl[i][1])), i, 1, n),
  polylogx : makelist( invE[i]*L[i], i, 1, n),
  logM : makelist( if M[i] > 0 then float(log(M[i])) else 0.0, i, 1, n),

  /* LOG model: M ~ a*L + b  */
  fit_log : rcc_linfit(L, M),
  r2_log  : rcc_r2(L, M, fit_log),

  /* POLYLOG model: M ~ a*(1/eps)*L + b */
  fit_polylog : rcc_linfit(polylogx, M),
  r2_polylog  : rcc_r2(polylogx, M, fit_polylog),

  /* POLY model: log(M) ~ c*L + b  (slope c is the polynomial exponent in 1/eps) */
  fit_loglog   : rcc_linfit(L, logM),
  r2_loglog    : rcc_r2(L, logM, fit_loglog),
  slope_loglog : fit_loglog[1],

  /* Classification logic (heuristic, with confidence annotations). */
  /* RC1 if the LOG model is an excellent fit AND the poly exponent ~ 0. */
  if (r2_log > 0.999 and abs(slope_loglog) < 0.15) then (
    label : "RC1",
    detail : sconcat("log-linear R^2=", r2_log,
                     "  poly-exp~", slope_loglog, "  (information-theoretically optimal)")
  )
  else if (slope_loglog > 1.5) then (
    /* Polynomial exponent well above 1 -> possibly super-poly territory.
       Distinguish RC3 by checking whether log(M)/L keeps climbing. */
    if slope_loglog > 3.0 then (
      label : "RC3",
      detail : sconcat("log-log slope=", slope_loglog,
                       " (super-polynomial growth)")
    ) else (
      label : "RC2",
      detail : sconcat("log-log slope=", slope_loglog, " (polynomial, exponent>1)")
    )
  )
  else if (r2_polylog > r2_log and r2_polylog > 0.99) then (
    label : "RC2-polylog",
    detail : sconcat("(1/eps)*log(1/eps) R^2=", r2_polylog,
                     "  poly-exp~", slope_loglog)
  )
  else (
    label : "RC2",
    detail : sconcat("log-log slope (poly exponent)=", slope_loglog,
                     "  log-linear R^2=", r2_log)
  ),
  [label, detail, [ ["r2_log", r2_log], ["r2_polylog", r2_polylog],
                    ["r2_loglog", r2_loglog], ["poly_exp", slope_loglog] ]]
)$

/* ---------------------------------------------------------------------
   1. ENGINE IMPLEMENTATIONS (the canonical five)

   Each engine is implemented as a partial-sum/product accumulator that,
   at truncation N, returns a record:
      [ S_N (exact rational/bigfloat), error_bound (bigfloat) ]
   where error_bound is a RIGOROUS bound on |alpha - S_N|.

   To support incremental sweeps efficiently, each engine also exposes a
   "step" function that takes (state) and returns (next_state), with the
   partial value stored in the state. We keep simple closed accumulators.
   --------------------------------------------------------------------- */

/* ----- G1.1 Gregory–Leibniz:  pi = 4*sum_{k>=0} (-1)^k/(2k+1) ----- */
/* Partial sum S_N uses terms k = 0..N-1 (N terms). */
rcc_gl_partial(n) := block(
  [s, k],
  s : 0,
  for k : 0 thru n-1 do
    s : s + (-1)^k / (2*k+1),
  4*s
)$
/* Rigorous alternating-series error bound: |pi - S_N| <= 4/(2N+1)
   (next omitted term magnitude); essay uses 4/(2N+3) for the (N+1)-term form. */
rcc_gl_errbound(n) := bfloat(4/(2*n+1))$

/* ----- G1.2 Nilakantha:  pi = 3 + sum_{k>=1} (-1)^(k+1)*4/[(2k)(2k+1)(2k+2)] ----- */
rcc_nila_partial(n) := block(
  [s, k],
  s : 3,
  for k : 1 thru n do
    s : s + (-1)^(k+1) * 4 / ((2*k)*(2*k+1)*(2*k+2)),
  s
)$
/* Alternating-series bound: magnitude of first omitted term (k = n+1). */
rcc_nila_errbound(n) := bfloat( 4/((2*(n+1))*(2*(n+1)+1)*(2*(n+1)+2)) )$

/* ----- G1.3 Wallis product:  pi = 2*prod_{k>=1} (2k)^2/[(2k-1)(2k+1)] ----- */
rcc_wallis_partial(n) := block(
  [p, k],
  p : 2,
  for k : 1 thru n do
    p : p * (2*k)^2 / ((2*k-1)*(2*k+1)),
  p
)$
/* Rigorous log-tail bound: log-error tail is O(1/N).  The product
   converges to pi from below; remaining factors each contribute
   (1 + 1/(4k^2-1)). Tail bound on the relative error ~ sum_{k>n} 1/(4k^2) ~ 1/(4n).
   Absolute error bound ~ pi/(4n). We use a conservative pi/(4n). */
rcc_wallis_errbound(n) := bfloat(%pi/(4*n))$

/* ----- G1.4 Binomial series for sqrt(k):
         sqrt(k) = sum_{m>=0} C(2m,m)/4^m * (1 - 1/k)^m  ----- */
rcc_binom_partial(kk, n) := block(
  [s, m, rho],
  rho : 1 - 1/kk,
  s : 0,
  for m : 0 thru n-1 do
    s : s + binomial(2*m, m) / 4^m * rho^m,
  s
)$
/* Rigorous geometric tail bound. Term magnitude ~ rho^m/sqrt(pi m).
   Bounding C(2m,m)/4^m <= 1, the tail sum_{m>=N} rho^m = rho^N/(1-rho).
   With rho = 1-1/k, 1-rho = 1/k, so bound = k * rho^N. */
rcc_binom_errbound(kk, n) := block(
  [rho],
  rho : bfloat(1 - 1/kk),
  bfloat(kk) * rho^n
)$

/* ----- G1.5 Taylor series for e:  e = sum_{n>=0} 1/n! ----- */
rcc_e_partial(n) := block(
  [s, m],
  s : 0,
  for m : 0 thru n-1 do
    s : s + 1/m!,
  s
)$
/* Rigorous tail bound: e - S_N = sum_{m>=N} 1/m! <= (1/N!)*(1/(1-1/(N+1)))
   <= 3/N! for N >= 1. */
rcc_e_errbound(n) := if n < 1 then bfloat(3) else bfloat(3/n!)$

/* The reference value for an engine (for error verification). */
rcc_engine_ref(name) :=
  if name = "binom2"  then bfloat(sqrt(2))
  elseif name = "binom3"  then bfloat(sqrt(3))
  elseif name = "binom5"  then bfloat(sqrt(5))
  elseif name = "binom10" then bfloat(sqrt(10))
  elseif name = "e" then rcc_e_ref
  else rcc_pi_ref$

/* Dispatch: partial sum and error bound by engine name. */
rcc_engine_partial(name, n) :=
  if name = "gl"     then rcc_gl_partial(n)
  elseif name = "nila"   then rcc_nila_partial(n)
  elseif name = "wallis" then rcc_wallis_partial(n)
  elseif name = "binom2"  then rcc_binom_partial(2, n)
  elseif name = "binom3"  then rcc_binom_partial(3, n)
  elseif name = "binom5"  then rcc_binom_partial(5, n)
  elseif name = "binom10" then rcc_binom_partial(10, n)
  elseif name = "e"      then rcc_e_partial(n)
  else error("unknown engine", name)$

rcc_engine_errbound(name, n) :=
  if name = "gl"     then rcc_gl_errbound(n)
  elseif name = "nila"   then rcc_nila_errbound(n)
  elseif name = "wallis" then rcc_wallis_errbound(n)
  elseif name = "binom2"  then rcc_binom_errbound(2, n)
  elseif name = "binom3"  then rcc_binom_errbound(3, n)
  elseif name = "binom5"  then rcc_binom_errbound(5, n)
  elseif name = "binom10" then rcc_binom_errbound(10, n)
  elseif name = "e"      then rcc_e_errbound(n)
  else error("unknown engine", name)$

/* Predicted RC class per engine (the essay's hand-derived table). */
rcc_engine_predicted(name) :=
  if name = "gl"     then "RC2"
  elseif name = "nila"   then "RC2"
  elseif name = "wallis" then "RC2-polylog"
  elseif name = "e"      then "RC1"   /* factorial denom + super-geometric conv => log bits */
  else "RC1"$   /* all binom variants */

rcc_engine_pretty(name) :=
  if name = "gl"     then "Gregory-Leibniz (pi)"
  elseif name = "nila"   then "Nilakantha (pi)"
  elseif name = "wallis" then "Wallis product (pi)"
  elseif name = "binom2"  then "Binomial series sqrt(2)"
  elseif name = "binom3"  then "Binomial series sqrt(3)"
  elseif name = "binom5"  then "Binomial series sqrt(5)"
  elseif name = "binom10" then "Binomial series sqrt(10)"
  elseif name = "e"      then "Taylor series (e)"
  else name$

rcc_all_engines : ["gl", "nila", "wallis", "binom2", "binom3",
                    "binom5", "binom10", "e"]$
/* (terminator confirmed) */

/* ---------------------------------------------------------------------
   2. CONVERGENCE-RATE / TOLERANCE SWEEP

   For a given engine and target tolerance eps, find the smallest N such
   that the RIGOROUS error bound is < eps. Returns N. We grow N adaptively.
   --------------------------------------------------------------------- */
rcc_find_N(name, eps) := block(
   [n, bnd, stp, guard],
  n : 1,
   stp : 1,
  guard : 0,
  /* exponential search for an upper bracket */
  while (rcc_engine_errbound(name, n) >= eps) and (guard < 200) do (
     n : n + stp,
     stp : stp * 2,
    guard : guard + 1
  ),
  /* linear back-off to the minimal N (bisection-ish refine) */
  block(
    [lo, hi, mid],
    lo : max(1, floor(n/2)),
    hi : n,
    while lo < hi do (
      mid : floor((lo + hi)/2),
      if rcc_engine_errbound(name, mid) < eps
        then hi : mid
        else lo : mid + 1
    ),
    lo
  )
)$

/* Build the (eps, N, bits) sweep table for one engine over a ladder. */
rcc_sweep(name, kmax) := block(
  [ladder, rows, eps, N, S, b],
  ladder : rcc_eps_ladder(kmax),
  rows : [],
  for eps in ladder do (
    N : rcc_find_N(name, eps),
    S : rcc_engine_partial(name, N),
    b : rcc_bits(rat(S)),
    rows : append(rows, [[eps, N, b]])
  ),
  rows
)$

/* G2.x — Verify rigorous error bounds actually hold against the reference. */
rcc_verify_bounds(name, Nlist) := block(
  [ref, ok, n, S, err, bnd, fails],
  ref : rcc_engine_ref(name),
  ok : true,
  fails : [],
  for n in Nlist do (
    S : rcc_engine_partial(name, n),
    err : rcc_abserr(S, ref),
    bnd : rcc_engine_errbound(name, n),
    if err > bnd then (
      ok : false,
      fails : append(fails, [[n, err, bnd]])
    )
  ),
  [ok, fails]
)$

/* ---------------------------------------------------------------------
   3. DENOMINATOR-GROWTH VERIFICATION (the load-bearing PNT step)
   --------------------------------------------------------------------- */

/* Second Chebyshev function psi(M) = log lcm(1,...,M).  G3.1 */
rcc_lcm_upto(M) := block(
  [L, i],
  L : 1,
  for i : 2 thru M do L : lcm(L, i),
  L
)$
rcc_psi(M) := float(log(rcc_lcm_upto(M)))$

/* log lcm(1,3,5,...,2N+1) — odd lcm used by Gregory–Leibniz. */
rcc_odd_lcm_log(N) := block(
  [L, k],
  L : 1,
  for k : 0 thru N do L : lcm(L, 2*k+1),
  float(log(L))
)$

/* G3.3 — log lcm of triple products (2k)(2k+1)(2k+2), k=1..N. */
rcc_triple_lcm_log(N) := block(
  [L, k],
  L : 1,
  for k : 1 thru N do L : lcm(L, (2*k)*(2*k+1)*(2*k+2)),
  float(log(L))
)$

/* G3.4 — Wallis product denominator: prod (2k-1)(2k+1), k=1..N. log of it. */
rcc_wallis_den_log(N) := block(
  [s, k],
  s : 0.0,
  for k : 1 thru N do
    s : s + float(log((2*k-1)*(2*k+1))),
  s
)$

/* G3.1 report: psi(M)/M -> 1. */
rcc_report_chebyshev(maxM, stepM) := block(
  [M, ratio, rows],
  rows : [],
  print("  --- G3.1  Chebyshev psi(M) = log lcm(1..M),  expect psi(M)/M -> 1 ---"),
  M : stepM,
  while M <= maxM do (
    ratio : rcc_psi(M)/M,
    print(sconcat("    M=", M, "   psi(M)=", rcc_psi(M),
                  "   psi(M)/M=", ratio)),
    rows : append(rows, [[M, ratio]]),
    M : M + stepM
  ),
  rows
)$

/* G3.2 — Naive O(N log N) vs tight O(N) denominator-bit comparison.
   For Gregory–Leibniz we measure the ACTUAL reduced denominator bit-length
   of S_N and compare to N*log2(N) (naive) and N (tight). */
rcc_report_den_growth(name, Nlist) := block(
  [n, S, db, naive, tight, rows],
  rows : [],
  print(sconcat("  --- G3.2  Denominator growth for ", rcc_engine_pretty(name),
                " : actual reduced-denominator bits vs N and N*log2(N) ---")),
  for n in Nlist do (
    S : rat(rcc_engine_partial(name, n)),
    db : rcc_intbits(abs(denom(S))),
    naive : float(n*log(n)/log(2)),
    tight : float(n),
    print(sconcat("    N=", n, "   den-bits=", db,
                  "   N=", tight, "   N*log2(N)=", naive,
                  "   ratio(db/N)=", float(db/max(1,n)))),
    rows : append(rows, [[n, db, tight, naive]])
  ),
  rows
)$

/* ---------------------------------------------------------------------
   4. CLASSIFICATION TABLE (reproduce from data)
   --------------------------------------------------------------------- */

/* Classify N(eps) growth: feed (eps, N) into the fitter. */
rcc_classify_N(sweep_rows) := block(
  [tbl],
  tbl : makelist([sweep_rows[i][1], sweep_rows[i][2]], i, 1, length(sweep_rows)),
  rcc_fit_class(tbl)
)$

/* Classify bits(eps) growth: feed (eps, bits). */
rcc_classify_bits(sweep_rows) := block(
  [tbl],
  tbl : makelist([sweep_rows[i][1], sweep_rows[i][3]], i, 1, length(sweep_rows)),
  rcc_fit_class(tbl)
)$

/* G4.2 — Wallis vs Gregory-Leibniz side-by-side bit comparison. */
rcc_wallis_vs_gl(kmax) := block(
  [gl, wl, i, n],
  gl : rcc_sweep("gl", kmax),
  wl : rcc_sweep("wallis", kmax),
  print("  --- G4.2  Wallis vs Gregory-Leibniz: bits-vs-eps side by side ---"),
  print("    eps          GL:N      GL:bits     Wallis:N    Wallis:bits   ratio(W/GL bits)"),
  n : min(length(gl), length(wl)),
  for i : 1 thru n do
    print(sconcat("    ", float(gl[i][1]),
                  "   ", gl[i][2], "   ", gl[i][3],
                  "      ", wl[i][2], "   ", wl[i][3],
                  "    ", float(wl[i][3]/max(1,gl[i][3])))),
  [gl, wl]
)$

/* G4.3 — Wallis is RC2 not RC3: bits / ((1/eps)*(1/eps)^delta) -> 0. */
rcc_wallis_rc2_check(kmax, delta) := block(
  [wl, i, eps, bits, val, rows],
  wl : rcc_sweep("wallis", kmax),
  rows : [],
  print(sconcat("  --- G4.3  Wallis RC2 check: bits / ((1/eps)^(1+delta)) -> 0, delta=",
                float(delta), " ---")),
  for i : 1 thru length(wl) do (
    eps : wl[i][1],
    bits : wl[i][3],
    val : float(bits / (1/bfloat(eps))^(1+delta)),
    print(sconcat("    eps=", float(eps), "   bits=", bits,
                  "   bits/(1/eps)^(1+delta)=", val)),
    rows : append(rows, [[eps, val]])
  ),
  print("    (decreasing toward 0 confirms Wallis is RC2, not RC3.)"),
  rows
)$

/* ---------------------------------------------------------------------
   5. OPTIMALITY / LOWER-BOUND CLAIM
   --------------------------------------------------------------------- */

/* G5.1 — Information-theoretic floor: bits >= log2(1/eps) for all engines. */
rcc_floor_check(name, kmax) := block(
  [sw, i, eps, bits, floorbits, ok, rows],
  sw : rcc_sweep(name, kmax),
  ok : true,
  rows : [],
  for i : 1 thru length(sw) do (
    eps : sw[i][1],
    bits : sw[i][3],
    floorbits : float(log(1/bfloat(eps))/log(2)),
    if bits < floorbits then ok : false,
    rows : append(rows, [[eps, bits, floorbits]])
  ),
  [ok, rows]
)$

/* G5.2 — Binomial sqrt(k) saturates the floor: bits/log2(1/eps) -> const. */
rcc_saturation_check(name, kmax) := block(
  [sw, i, eps, bits, floorbits, ratio, rows],
  sw : rcc_sweep(name, kmax),
  rows : [],
  print(sconcat("  --- G5.2  Saturation for ", rcc_engine_pretty(name),
                ": bits/log2(1/eps) -> const (RC1 optimality) ---")),
  for i : 1 thru length(sw) do (
    eps : sw[i][1],
    bits : sw[i][3],
    floorbits : float(log(1/bfloat(eps))/log(2)),
    ratio : float(bits/max(1.0, floorbits)),
    print(sconcat("    eps=", float(eps), "   bits=", bits,
                  "   log2(1/eps)=", floorbits, "   ratio=", ratio)),
    rows : append(rows, [[eps, ratio]])
  ),
  rows
)$

/* ---------------------------------------------------------------------
   6. HYPERGEOMETRIC REGULARITY CONDITION (decidability check)
   --------------------------------------------------------------------- */

/* G6.1 — Term-ratio rationality checker.
   Given a symbolic term a(n), compute simplify(a(n+1)/a(n)) and test
   whether it is a rational function of n (ratp after ratsimp). */
rcc_is_rational_in(expr, var) := block(
  [r],
  r : ratsimp(expr),
  /* A rational function of var: numerator and denominator are polynomials in var. */
  polynomialp(num(r), [var]) and polynomialp(denom(r), [var])
)$

rcc_hypergeometric_check(termexpr, n) := block(
  [ratio],
  ratio : ratsimp( subst(n = n+1, termexpr) / termexpr ),
  [rcc_is_rational_in(ratio, n), ratio]
)$

rcc_report_hypergeometric() := block(
  [res, kk],
  print("  --- G6.1  Hypergeometric term-ratio rationality checks ---"),

  /* Gregory-Leibniz term a_k = (-1)^k/(2k+1) */
  res : rcc_hypergeometric_check((-1)^n/(2*n+1), n),
  print(sconcat("    Gregory-Leibniz   hypergeometric? ", res[1],
                "   ratio=", res[2])),

  /* Nilakantha term a_k = (-1)^(k+1)*4/((2k)(2k+1)(2k+2)) */
  res : rcc_hypergeometric_check((-1)^(n+1)*4/((2*n)*(2*n+1)*(2*n+2)), n),
  print(sconcat("    Nilakantha        hypergeometric? ", res[1],
                "   ratio=", res[2])),

  /* Wallis factor f_k = (2k)^2/((2k-1)(2k+1)) (treated as product term) */
  res : rcc_hypergeometric_check((2*n)^2/((2*n-1)*(2*n+1)), n),
  print(sconcat("    Wallis (factor)   hypergeometric? ", res[1],
                "   ratio=", res[2])),

  /* Binomial sqrt(k) term a_m = C(2m,m)/4^m*(1-1/kk)^m ; use kk symbolic */
  res : rcc_hypergeometric_check(binomial(2*n,n)/4^n*rho^n, n),
  print(sconcat("    Binomial sqrt(k)  hypergeometric? ", res[1],
                "   ratio=", res[2])),

  /* Taylor for e: a_n = 1/n! */
  res : rcc_hypergeometric_check(1/n!, n),
  print(sconcat("    Taylor e          hypergeometric? ", res[1],
                "   ratio=", res[2])),
  'done
)$

/* G6.2 — AGM negative test.
   The AGM iteration: a_{n+1} = (a_n + b_n)/2, b_{n+1} = sqrt(a_n b_n).
   The "term ratio" of the b-sequence involves sqrt and is not a rational
   function of the index n. We exhibit symbolically that b_{n+1}/b_n
   carries a square root that ratsimp cannot remove. */
rcc_report_agm_negative() := block(
  [ratio, israt],
  print("  --- G6.2  AGM negative test: term ratio involves sqrt (NOT rational) ---"),
  /* Symbolic single step: with symbols a,b for current pair, the new b is sqrt(a*b). */
  ratio : ratsimp( sqrt(a*b) / b ),   /* = sqrt(a/b), irrational in the state */
  israt : freeof(sqrt, ratify_safe(ratio)),
  print(sconcat("    AGM step b_{n+1}/b_n = sqrt(a*b)/b = ", ratio)),
  print("    This ratio depends on sqrt(a/b): NOT a rational function of the index."),
  print("    => AGM is excluded from the hypergeometric class (essay's claim)."),
  'done
)$

/* helper used only to keep ratsimp from erroring on sqrt forms */
ratify_safe(e) := e$

/* G6.3 — Gauss-theorem spot check: 2^(1/3) via a hypergeometric representation.
   2^(1/3) = (1 + 1)^(1/3); use (1-x)^(-1/3) style binomial expansion at a
   suitable algebraic argument and confirm Theta(log(1/eps)) bit-cost
   empirically. We implement the binomial series for k^(1/3):
      (1 - x)^(-1/3) = sum C(3n,n)-style... we instead use the generic
      generalized-binomial coefficient for exponent -1/3. */
rcc_cbrt_binom_partial(target, x, n) := block(
  /* (1-x)^(-1/3) = sum_{m>=0} binom(-1/3, m) (-x)^m
     We use the generalized binomial coefficient via gamma-free product. */
  [s, m, coeff, j],
  s : 0,
  for m : 0 thru n-1 do (
    coeff : 1,
    for j : 0 thru m-1 do
      coeff : coeff * (-1/3 - j)/(j+1),
    s : s + coeff * (-x)^m
  ),
  s
)$

/* For 2^(1/3): write 2^(1/3) = (1 - x)^(-1/3) with (1-x)^(-1) = 2,
   i.e. 1 - x = 1/2, x = 1/2.  Then (1-x)^(-1/3) = 2^(1/3). */
rcc_cbrt2_partial(n) := rcc_cbrt_binom_partial(2, 1/2, n)$
rcc_cbrt2_errbound(n) := bfloat( 3 * (1/2)^n )$  /* conservative geometric bound */

rcc_report_gauss_spotcheck(kmax) := block(
  [eps, N, S, b, ref, floorbits, ratio, ladder, rows],
  print("  --- G6.3  Gauss spot check: 2^(1/3) via binomial(-1/3) series ---"),
  ref : bfloat(2^(1/3)),
  ladder : rcc_eps_ladder(kmax),
  rows : [],
  for eps in ladder do (
    /* find N s.t. geometric bound < eps */
    N : 1,
    while rcc_cbrt2_errbound(N) >= eps do N : N + 1,
    S : rcc_cbrt2_partial(N),
    b : rcc_bits(rat(S)),
    floorbits : float(log(1/bfloat(eps))/log(2)),
    ratio : float(b/max(1.0, floorbits)),
    print(sconcat("    eps=", float(eps), "   N=", N, "   bits=", b,
                  "   log2(1/eps)=", floorbits, "   ratio=", ratio)),
    rows : append(rows, [[eps, N, b]])
  ),
  print("    Bits track log2(1/eps): supports RC1 for algebraic 2^(1/3)."),
  rcc_classify_bits(rows)
)$

/* ---------------------------------------------------------------------
   7. STRETCH / RESEARCH-FACING GOALS
   --------------------------------------------------------------------- */

/* G7.1 — Gauss-Legendre AGM for pi, exact rationals, bit-vs-eps profile.
   Iteration:
     a0=1, b0=1/sqrt(2), t0=1/4, p0=1
     a_{n+1} = (a+b)/2,  b_{n+1}=sqrt(a b),  t_{n+1}=t - p (a - a_{n+1})^2,
     p_{n+1}=2 p
     pi ~ (a_{n+1}+b_{n+1})^2 / (4 t_{n+1})
   Square roots break exact rationality, so we run it with bigfloats but
   track an interval-style error via successive-iterate differences and
   report the bit-length of a rational reconstruction (best rational within
   the achieved tolerance). The point: AGM lands in RC1. */
rcc_agm_pi(iters) := block(
  [a, b, t, p, i, an, prevpi, piapprox, prec],
  fpprec : rcc_fpprec,
  a : bfloat(1),
  b : bfloat(1/sqrt(2)),
  t : bfloat(1/4),
  p : bfloat(1),
  piapprox : bfloat(0),
  for i : 1 thru iters do (
    an : (a + b)/2,
    b  : sqrt(a*b),
    t  : t - p*(a - an)^2,
    a  : an,
    p  : 2*p
  ),
  piapprox : (a + b)^2/(4*t),
  piapprox
)$

rcc_report_agm_pi(maxiters) := block(
  [i, papprox, err, bits_est, rrat, rows],
  print("  --- G7.1  AGM (Gauss-Legendre) for pi: quadratic convergence, RC1 ---"),
  print("    iters    |pi - approx|         ~achieved bits (log2(1/err))"),
  rows : [],
  for i : 1 thru maxiters do (
    papprox : rcc_agm_pi(i),
    err : rcc_abserr(papprox, rcc_pi_ref),
    bits_est : if err <= 0 then float(rcc_fpprec*log(10)/log(2))
               else float(log(1/err)/log(2)),
    print(sconcat("    ", i, "      ", err, "     ", bits_est)),
    rows : append(rows, [[err, i]])
  ),
  print("    Error squares each step (doubling correct digits) => RC1 outside"),
  print("    the hypergeometric class, confirming the essay's collapse caveat."),
  rows
)$

/* G7.2 — Open-question probe: confirm a fast hypergeometric pi-series
   (Chudnovsky-style per-term structure) still yields polynomial certificate
   bit-length when summed naively (common denominator blows up).
   We use the simpler Ramanujan 1910 series as a representative fast
   hypergeometric engine:
     1/pi = (2 sqrt(2)/9801) * sum_{m>=0} (4m)!(1103+26390 m)/((m!)^4 396^(4m))
   Per-term convergence is ~ 10^-8 per term (super fast: N(eps)=Theta(log/...)),
   BUT the naive common denominator carries factorial growth.  We measure the
   reduced-rational bit-length of the partial reciprocal sum and show it grows
   polynomially (super-linearly) in 1/eps when summed naively. */
rcc_ramanujan_recip_partial(n) := block(
  [s, m],
  s : 0,
  for m : 0 thru n-1 do
    s : s + (4*m)! * (1103 + 26390*m) / ((m!)^4 * 396^(4*m)),
  /* 1/pi = (2 sqrt 2 / 9801) * s ; we keep the rational core 's' for bit accounting */
  s
)$
rcc_report_ramanujan_probe(maxN) := block(
  [n, S, b, rows],
  print("  --- G7.2  Open-question probe: Ramanujan fast hypergeometric pi-series ---"),
  print("    Per-term convergence ~10^-8/term (few terms suffice), but naive"),
  print("    common-denominator bit-length grows fast. N -> reduced-core bits:"),
  rows : [],
  for n : 1 thru maxN do (
    S : rat(rcc_ramanujan_recip_partial(n)),
    b : rcc_bits(S),
    print(sconcat("    N=", n, "   core-bits=", b)),
    rows : append(rows, [[n, b]])
  ),
  print("    Bit-length per term grows ~ linearly in N while N(eps)~log(1/eps);"),
  print("    naive summation therefore does NOT reach RC1 — binary-splitting would."),
  print("    Heuristic verdict (low confidence): no naive-hypergeometric RC1 engine"),
  print("    for pi found; consistent with the essay's OPEN question."),
  rows
)$

/* G7.3 — Benchmark-suite export to CSV (machine-readable). */
rcc_export_benchmark(filename, kmax) := block(
  [stream, name, sw, i, line],
  stream : openw(filename),
  printf(stream, "engine,predicted_rc,eps,N,bits~%"),
  for name in rcc_all_engines do (
    sw : rcc_sweep(name, kmax),
    for i : 1 thru length(sw) do
      printf(stream, "~a,~a,~a,~a,~a~%",
             rcc_engine_pretty(name),
             rcc_engine_predicted(name),
             float(sw[i][1]),
             sw[i][2],
             sw[i][3])
  ),
  close(stream),
  print(sconcat("  --- G7.3  Benchmark suite written to ", filename, " ---")),
  'done
)$

/* ---------------------------------------------------------------------
   8. REPORTING CONTRACT

   For each engine: (name, hypergeometric?, measured N(eps) class,
   measured bits-vs-eps class, predicted RC class, agreement verdict).
   --------------------------------------------------------------------- */

/* Determine the hypergeometric yes/no for an engine symbolically. */
rcc_engine_hypergeometric(name) := block(
  [res],
  if name = "gl" then
    res : rcc_hypergeometric_check((-1)^n/(2*n+1), n)
  elseif name = "nila" then
    res : rcc_hypergeometric_check((-1)^(n+1)*4/((2*n)*(2*n+1)*(2*n+2)), n)
  elseif name = "wallis" then
    res : rcc_hypergeometric_check((2*n)^2/((2*n-1)*(2*n+1)), n)
  elseif name = "e" then
    res : rcc_hypergeometric_check(1/n!, n)
  else
    res : rcc_hypergeometric_check(binomial(2*n,n)/4^n*rho^n, n),
  res[1]
)$

/* Agreement verdict: compare measured bits-class to predicted, with
   RC2-polylog treated as a subclass of RC2 for the headline match. */
rcc_verdict(measured, predicted) := block(
  [norm_m, norm_p],
  norm_m : if measured = "RC2-polylog" then "RC2" else measured,
  norm_p : if predicted = "RC2-polylog" then "RC2" else predicted,
  if norm_m = norm_p then "AGREE"
  else sconcat("DISAGREE (measured=", measured, ", predicted=", predicted, ")")
)$

rcc_report_engine(name, kmax) := block(
  [sw, hyp, ncls, bcls, pred, verdict, bndres],
  sw  : rcc_sweep(name, kmax),
  hyp : rcc_engine_hypergeometric(name),
  ncls : rcc_classify_N(sw),
  bcls : rcc_classify_bits(sw),
  pred : rcc_engine_predicted(name),
  verdict : rcc_verdict(bcls[1], pred),
  /* sanity: verify rigorous error bounds at the swept N's */
  bndres : rcc_verify_bounds(name, makelist(sw[i][2], i, 1, length(sw))),
  print("  ----------------------------------------------------------"),
  print(sconcat("  ENGINE: ", rcc_engine_pretty(name))),
  print(sconcat("    hypergeometric?       ", hyp)),
  print(sconcat("    rigorous bounds hold?  ", bndres[1])),
  print(sconcat("    measured N(eps) class: ", ncls[1], "   [", ncls[2], "]")),
  print(sconcat("    measured bits class:   ", bcls[1], "   [", bcls[2], "]")),
  print(sconcat("    predicted RC class:    ", pred)),
  print(sconcat("    VERDICT:               ", verdict)),
  [name, hyp, ncls[1], bcls[1], pred, verdict]
)$

/* ---------------------------------------------------------------------
   TOP-LEVEL DRIVER
   --------------------------------------------------------------------- */
rcc_run_all([opts]) := block(
  [kmax, summary, name, ssize, denN],
  kmax : if length(opts) >= 1 then opts[1] else 6,   /* eps down to 10^-kmax */
  ssize : if length(opts) >= 2 then opts[2] else 14, /* sample N's for diagnostics */
  print("=============================================================="),
  print("  RATIONAL CERTIFICATE COMPLEXITY (RCC) — COMPANION REPORT"),
  print(sconcat("  tolerance ladder: eps = 10^-1 ... 10^-", kmax)),
  print("=============================================================="),

  /* Section 6: hypergeometric regularity */
  print(""),
  print("== Section 6: Hypergeometric Regularity Condition =="),
  rcc_report_hypergeometric(),
  rcc_report_agm_negative(),
  rcc_report_gauss_spotcheck(min(kmax, 8)),

  /* Section 3: denominator growth / PNT */
  print(""),
  print("== Section 3: Denominator-Growth Verification (PNT step) =="),
  rcc_report_chebyshev(60, 10),
  denN : [4, 8, 16, 32, 64],
  rcc_report_den_growth("gl", denN),
  print(sconcat("  --- G3.3  Nilakantha triple-product lcm (expect Theta(N)) ---")),
  for n in denN do
    print(sconcat("    N=", n, "   log lcm(triples)=", rcc_triple_lcm_log(n),
                  "   ratio/N=", float(rcc_triple_lcm_log(n)/n))),
  print(sconcat("  --- G3.4  Wallis denominator log (expect ~ N log N) ---")),
  for n in denN do
    print(sconcat("    N=", n, "   log den=", rcc_wallis_den_log(n),
                  "   ratio/(N log N)=",
                  float(rcc_wallis_den_log(n)/max(1,(n*log(n)))))),

  /* Section 2 & 4: per-engine sweep, classification & reporting contract */
  print(""),
  print("== Section 2/4/8: Per-Engine Sweep, Classification & Verdicts =="),
  summary : [],
  for name in rcc_all_engines do
    summary : append(summary, [rcc_report_engine(name, kmax)]),

  /* Section 4 headline comparisons */
  print(""),
  print("== Section 4: Headline Distinctions =="),
  rcc_wallis_vs_gl(kmax),
  rcc_wallis_rc2_check(kmax, 1/4),

  /* Section 5: optimality / lower bound */
  print(""),
  print("== Section 5: Optimality / Information-Theoretic Floor =="),
  block([fc],
    fc : rcc_floor_check("gl", kmax),
    print(sconcat("  G5.1  GL respects floor (bits >= log2(1/eps))? ", fc[1])),
    fc : rcc_floor_check("binom2", kmax),
    print(sconcat("  G5.1  binom2 respects floor? ", fc[1]))
  ),
  rcc_saturation_check("binom2", kmax),

  /* Section 7: stretch goals */
  print(""),
  print("== Section 7: Stretch / Research-Facing =="),
  rcc_report_agm_pi(7),
  rcc_report_ramanujan_probe(6),
  rcc_export_benchmark("rcc_benchmark.csv", kmax),

  /* Final summary table */
  print(""),
  print("== FINAL SUMMARY (Reporting Contract, G8) =="),
  print("  engine | hyper? | N(eps) class | bits class | predicted | verdict"),
  for row in summary do
    print(sconcat("  ", row[1], " | ", row[2], " | ", row[3],
                  " | ", row[4], " | ", row[5], " | ", row[6])),
  print("=============================================================="),
  print("  Discrepancies (DISAGREE) are the headline output: informative,"),
  print("  not invalidating — exactly as the essay frames them."),
  print("=============================================================="),
  summary
)$

/* Auto-run when batched.  Comment out for interactive load-only use. */
rcc_run_all(6, 14)$