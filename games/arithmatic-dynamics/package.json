{
  "name": "arithmetic-dynamics",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Touch-first puzzle game teaching the mechanics of arithmetic.",
  "scripts": {
    "test": "node --test tests/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
